# Copy this file to .env and fill in real values before running.
# None of these are AI provider API keys — those are entered per-user through
# the running app's Provider Manager screen and stored encrypted in the database.
# This file only holds infrastructure secrets for the backend itself.

ENVIRONMENT=development

# Dev: sqlite file (default). Prod: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./nexus.db
# Production example:
# postgresql+psycopg2://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This key encrypts every user's provider API keys at rest. Keep it safe and
# back it up — if it's lost, every stored credential becomes undecryptable.
ENCRYPTION_KEY=REPLACE_WITH_A_GENERATED_FERNET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=20160

SESSION_COOKIE_NAME=nexus_session

# Your deployed frontend origin(s), comma-separated, no trailing slash.
# Dev example: http://localhost:5173
# Prod example: https://nexus-ai.vercel.app
CORS_ORIGINS=http://localhost:5173

# Set both to true/none in production (cross-site cookie between Vercel + Render/etc.)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# RAG — document storage
# Dev default: a local folder next to the running server.
# Production: set this to a persistent volume mount path (e.g. /data/rag_uploads).
# If you host on Render, attach a persistent disk and point this at its mount path.
# For S3/R2/cloud storage, swap the rag/ingestion.py file-write logic instead.
RAG_UPLOAD_DIR=./rag_uploads
# Per-file upload size limit in megabytes
RAG_MAX_FILE_MB=50
